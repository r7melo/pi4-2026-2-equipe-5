@startuml ZL-Eng-Diagrama-Completo
title ZL-Eng - Diagrama de Casos de Uso
left to right direction
skinparam packageStyle rectangle

' ===== Atores =====
actor "Usuário" as Usuario
actor "Administrador" as Administrador
actor "Engenharia" as Engenharia
actor "Financeiro" as Financeiro
actor "Instalador de Campo" as Instalador

Administrador --|> Usuario
Engenharia --|> Usuario
Financeiro --|> Usuario
Instalador --|> Usuario

' ===== Casos de uso: autenticação =====
usecase "UC-01 - Login" as Login
usecase "UC-02 - Emitir Token de Acesso" as EmitirToken
usecase "UC-03 - Acessar Recursos" as AcessarRecursos
usecase "UC-04 - Validar Autorização de Acesso" as ValidarAutorizacao
usecase "UC-35 - Solicitar Recuperação de Senha" as SolicitarRecuperacao
usecase "UC-36 - Atualizar Senha" as AtualizarSenha

' ===== Casos de uso: cadastros =====
usecase "UC-05 - Cadastrar Administrador" as CadAdmin
usecase "UC-06 - Cadastrar Engenheiro" as CadEng
usecase "UC-07 - Cadastrar Financeiro" as CadFin
usecase "UC-08 - Gerenciar Clientes (CRUD)" as CadClientes
usecase "UC-09 - Cadastrar Instalador de Campo" as CadInstalador
usecase "UC-37 - Desativar Usuário" as DesativarUsuario
usecase "UC-38 - Reativar Usuário" as ReativarUsuario

' ===== Casos de uso: obra =====
usecase "UC-10 - Cadastrar Obra" as CadObra
usecase "UC-11 - Apagar Obra" as ApagarObra
usecase "UC-12 - Alterar Status da Obra" as AlterarStatus
usecase "UC-13 - Definir Obra para Instalação" as DefinirObra
usecase "UC-14 - Criar Comentário sobre a Manutenção" as CriarComentarioManut
usecase "UC-17 - Editar Obra (página Obras)" as EditarObra
usecase "UC-19 - Adicionar Comentário na Obra" as ComentarObra

' ===== Subjects =====
rectangle "Gerenciar Kanban" as Kanban {
  usecase "UC-15 - Inserir Cartão de Obra no Kanban" as InserirCartao
  usecase "UC-16 - Deletar Cartão de Obra no Kanban" as DeletarCartao
  usecase "UC-18 - Mover Cartão no Kanban" as MoverCartao
}

rectangle "Linha do Tempo da Obra" as Timeline {
  usecase "UC-20 - Registrar Ação" as RegistrarAcao
  usecase "UC-29 - Consultar Linha do Tempo da Obra" as ConsultarTimeline
  usecase "UC-30 - Incluir Comentário na Linha do Tempo" as ComentarTimeline
}

rectangle "Gerenciar Gantt" as Gantt {
  usecase "UC-21 - Gerenciar Equipe da Programação" as GerenciarEquipe
  usecase "UC-22 - Programar Obra no Gantt" as ProgramarObra
}

rectangle "Gerenciar Instalação" as Instalacao {
  usecase "UC-23 - Exportar Detalhes de Instalação" as ExportarDetalhes
  usecase "UC-24 - Visualizar Detalhes da Instalação" as VisualizarDetalhes
  usecase "UC-25 - Realizar Manutenção" as RealizarManutencao
  usecase "UC-26 - Abrir Rota" as AbrirRota
}

rectangle "Consultar em Modo Leitura" as Consulta {
  usecase "UC-27 - Consultar Obras e Quadro Kanban" as ConsultarKanban
  usecase "UC-28 - Consultar Cronograma (Gantt)" as ConsultarGantt
}

rectangle "Gerenciar Materiais e Produtos" as Materiais {
  usecase "UC-39 - Gerenciar Produtos" as GerenciarProdutos
  usecase "UC-40 - Adicionar Material à Obra" as AdicionarMaterial
  usecase "UC-41 - Atualizar Status do Material" as AtualizarMaterial
}

rectangle "Gerenciar Financeiro" as Financas {
  usecase "UC-31 - Registrar Custos e Precificação da Obra" as RegistrarCustos
  usecase "UC-32 - Apurar Custo Total da Obra" as ApurarCusto
  usecase "UC-33 - Emitir DRE da Obra" as EmitirDRE
  usecase "UC-34 - Exportar Relatório Financeiro" as ExportarRelatorio
}

' ===== Associações: Usuário =====
Usuario --> Login
Usuario --> AcessarRecursos
Usuario --> SolicitarRecuperacao
Usuario --> AtualizarSenha

' ===== Associações: Administrador =====
Administrador --> CadAdmin
Administrador --> CadEng
Administrador --> CadFin
Administrador --> CadClientes
Administrador --> CadInstalador
Administrador --> DesativarUsuario
Administrador --> ReativarUsuario
Administrador --> CadObra
Administrador --> ApagarObra
Administrador --> EditarObra
Administrador --> ComentarObra
Administrador --> MoverCartao
Administrador --> GerenciarEquipe
Administrador --> ProgramarObra
Administrador --> ExportarDetalhes
Administrador --> ConsultarTimeline
Administrador --> GerenciarProdutos
Administrador --> AdicionarMaterial
Administrador --> AtualizarMaterial
Administrador --> ApurarCusto
Administrador --> EmitirDRE

' ===== Associações: Engenharia =====
Engenharia --> CadClientes
Engenharia --> CadObra
Engenharia --> ApagarObra
Engenharia --> EditarObra
Engenharia --> ComentarObra
Engenharia --> MoverCartao
Engenharia --> GerenciarEquipe
Engenharia --> ProgramarObra
Engenharia --> AdicionarMaterial
Engenharia --> ConsultarTimeline

' ===== Associações: Financeiro =====
Financeiro --> ConsultarKanban
Financeiro --> ConsultarGantt
Financeiro --> ConsultarTimeline
Financeiro --> GerenciarProdutos
Financeiro --> AtualizarMaterial
Financeiro --> RegistrarCustos
Financeiro --> ApurarCusto
Financeiro --> EmitirDRE
Financeiro --> ExportarRelatorio

' ===== Associações: Instalador de Campo =====
Instalador --> VisualizarDetalhes
Instalador --> RealizarManutencao
Instalador --> AbrirRota

' ===== Associações entre casos de uso =====
ProgramarObra ..> DefinirObra : <<include>>

' ===== Include =====
Login ..> EmitirToken : <<include>>
AcessarRecursos ..> ValidarAutorizacao : <<include>>
CadObra ..> InserirCartao : <<include>>
CadObra ..> RegistrarAcao : <<include>>
ApagarObra ..> DeletarCartao : <<include>>
MoverCartao ..> AlterarStatus : <<include>>
AlterarStatus ..> RegistrarAcao : <<include>>
DefinirObra ..> MoverCartao : <<include>>
RealizarManutencao ..> RegistrarAcao : <<include>>
EmitirDRE ..> ApurarCusto : <<include>>

' ===== Extend =====
CriarComentarioManut ..> RealizarManutencao : <<extend>>
ComentarObra ..> EditarObra : <<extend>>
ComentarTimeline ..> ConsultarTimeline : <<extend>>

@enduml
