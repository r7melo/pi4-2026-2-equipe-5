# Copie este arquivo para ".env" na raiz do projeto e ajuste se precisar.
# O ".env" real NUNCA deve ser commitado.

# --- Banco de dados (PostgreSQL) ---
DB_USER=pi4_user
DB_PASSWORD=pi4_password
DB_NAME=pi4_db

# --- Backend (ASP.NET Core) ---
BACKEND_PORT=8000
# OBRIGATÓRIO: segredo aleatório com no mínimo 32 caracteres. Gere com:  openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# --- Frontend ---
# Deixe vazio: o nginx encaminha /api e /hubs ao backend na mesma origem.
# Só preencha se a API estiver em outro endereço (ex.: http://192.168.0.10:8000).
VITE_API_URL=
