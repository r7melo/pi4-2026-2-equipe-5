# Copie este arquivo para ".env" na raiz do projeto e ajuste se precisar.
# O ".env" real NUNCA deve ser commitado.

# --- Banco de dados (PostgreSQL) ---
DB_USER=pi4_user
DB_PASSWORD=pi4_password
DB_NAME=pi4_db
DB_PORT=5432

# --- Backend (ASP.NET Core) ---
BACKEND_PORT=8000
# IP/nome da máquina que hospeda o Compose, acessível aos navegadores clientes.
# Use localhost apenas quando acessar o frontend nesta mesma máquina.
HOST_IP=localhost
# HTTPS do servidor Vite (certificado de desenvolvimento autoassinado).
# Para PWA em celular, o certificado precisa ser confiável no dispositivo.
USE_SSL=false
# Gere um segredo aleatório exclusivo (mínimo 32 caracteres) antes de iniciar.
JWT_SECRET=
